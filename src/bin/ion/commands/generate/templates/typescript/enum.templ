{%- set namespace_vec = namespace %}
{%- if namespace_vec|length > 0 %}
module {{ namespace_vec.0 }} {
{%- endif %}

import * as ion from 'ion-js';

/**
 * Represents the {{ model.name | upper_camel }} enum.
 * Generated from '{{ model.name }}' type definition.
 */
{%- if model.code_gen_type.enum is defined %}
export enum {{ model.name | upper_camel }} {
    {%- for variant in model.code_gen_type.enum.variants %}
    {{ variant | upper_camel }} = '{{ variant }}',
    {%- endfor %}
}

export namespace {{ model.name | upper_camel }} {
    /**
     * Reads a {{ model.name | upper_camel }} value from the provided IonReader.
     * @param reader The IonReader to read from.
     * @returns A {{ model.name | upper_camel }} enum value.
     * @throws Error if the reader is not positioned on a symbol or the symbol is not a valid enum variant.
     */
    export function readFrom(reader: ion.IonReader): {{ model.name | upper_camel }} {
        reader.next();
        if (reader.type() !== ion.IonTypes.SYMBOL) {
            throw new Error(`Expected Symbol for {{ model.name | upper_camel }}, found: ${ion.IonTypes[reader.type()]}`);
        }
        const symbolValue = reader.stringValue();
        switch (symbolValue) {
            {%- for variant in model.code_gen_type.enum.variants %}
            case '{{ variant }}': return {{ model.name | upper_camel }}.{{ variant | upper_camel }};
            {%- endfor %}
            default: throw new Error(`Invalid {{ model.name | upper_camel }} variant: ${symbolValue}`);
        }
    }

    /**
     * Writes the given {{ model.name | upper_camel }} enum value to the provided IonWriter.
     * @param writer The IonWriter to write to.
     * @param enumValue The {{ model.name | upper_camel }} enum value to write.
     */
    export function writeTo(writer: ion.IonWriter, enumValue: {{ model.name | upper_camel }}): void {
        writer.writeSymbol({{ model.name | upper_camel }}[enumValue]);
    }
}
{%- else %}
// Not an enum type
export type {{ model.name | upper_camel }} = any;
{%- endif %}

{%- if namespace_vec|length > 0 %}
} // end module {{ namespace_vec.0 }}
{%- endif %}