{%- set namespace_vec = namespace %}
{%- if namespace_vec|length > 0 %}
module {{ namespace_vec.0 }} {
{%- endif %}

import * as ion from 'ion-js';

/**
 * Represents the {{ model.name | upper_camel }} type.
 * Generated from '{{ model.name }}' type definition.
 */
{%- if model.code_gen_type.scalar is defined %}
/**
 * Represents a scalar type.
 */
export type {{ model.name | upper_camel }} = {{ model.code_gen_type.scalar | fully_qualified_type_name }};

export namespace {{ model.name | upper_camel }} {
    /**
     * Reads a {{ model.name | upper_camel }} value from the provided IonReader.
     * @param reader The IonReader to read from.
     * @returns A {{ model.name | upper_camel }} scalar value.
     * @throws Error if the reader is not positioned on the correct type.
     */
    export function readFrom(reader: ion.IonReader): {{ model.name | upper_camel }} {
        reader.next();
        {%- if model.code_gen_type.scalar == "string" %}
        if (reader.type() !== ion.IonTypes.STRING) {
            throw new Error(`Expected String for {{ model.name | upper_camel }}, found: ${ion.IonTypes[reader.type()]}`);
        }
        return reader.stringValue();
        {%- elif model.code_gen_type.scalar == "number" %}
        if (reader.type() !== ion.IonTypes.INT) {
            throw new Error(`Expected Int for {{ model.name | upper_camel }}, found: ${ion.IonTypes[reader.type()]}`);
        }
        return reader.numberValue();
        {%- elif model.code_gen_type.scalar == "boolean" %}
        if (reader.type() !== ion.IonTypes.BOOL) {
            throw new Error(`Expected Bool for {{ model.name | upper_camel }}, found: ${ion.IonTypes[reader.type()]}`);
        }
        return reader.booleanValue();
        {%- else %}
        return reader.value() as {{ model.name | upper_camel }};
        {%- endif %}
    }

    /**
     * Writes the given {{ model.name | upper_camel }} scalar value to the provided IonWriter.
     * @param writer The IonWriter to write to.
     * @param value The {{ model.name | upper_camel }} scalar value to write.
     */
    export function writeTo(writer: ion.IonWriter, value: {{ model.name | upper_camel }}): void {
        {%- if model.code_gen_type.scalar == "string" %}
        writer.writeString(value);
        {%- elif model.code_gen_type.scalar == "number" %}
        writer.writeInt(value);
        {%- elif model.code_gen_type.scalar == "boolean" %}
        writer.writeBool(value);
        {%- else %}
        writer.writeValue(value);
        {%- endif %}
    }
}
{%- else %}
// Not a scalar type
export type {{ model.name | upper_camel }} = any;
{%- endif %}

{%- if namespace_vec|length > 0 %}
} // end module {{ namespace_vec.0 }}
{%- endif %}